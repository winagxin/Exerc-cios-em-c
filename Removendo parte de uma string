#include <stdio.h>
#include <string.h>

int rmv(char s[], int p1, int p2){
    int x, i,j;
    int tam=strlen(s);
    if(p1<0||p1>=tam||p2<0||p2>=tam){
        printf("Posições invalidas.");
    } else {
        if(p1>p2){
            x=p1;
            p1=p2;
            p2=x;
        }
        for(i=p1,j=p2;s[j]!='\0';i++,j++){
            s[i]=s[j];
        }
        s[i]='\0';
        printf("\n%s", s);
    }
}

int main()
{
    char s[] = "independentemente";
    rmv(s,2,19);

    return 0;
}
