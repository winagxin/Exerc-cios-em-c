#include <stdio.h>
#include <string.h>

int rmv(char s[], int p1, int p2){
    int x, i,j;
    int tam=strlen(s);
    if(p1<0||p1>=tam||p2<0||p2>=tam){
        return 0;
    } else {
        if(p1>p2){
            x=p1;
            p1=p2;
            p2=x;
        }
        for(i=p1,j=p2+1;s[j]!='\0';i++,j++){
            s[i]=s[j];
        }
        s[i]='\0';
    }
    return 1;
}

int main()
{
    char s[] = "independentemente";
    if(rmv(s,2,16)==0){
        printf("Posições invalidas.");
    } else {
        printf("\n%s", s);
    }

    return 0;
}
