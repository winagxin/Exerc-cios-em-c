#include <stdio.h>
#include <string.h>
#define PROD 25
#define CAT 6

int busca(int vCodProd[], int n, int vlr){
    for(int i=0;i<n;i++){
        if(vCodProd[i]==vlr){
            return i;
        }
    }
    return -1;
}

void mostraProd(char v1[][40], int vCodProd[], int vEstoque[], int vtipo[], char v2[][20], float preco[], int tam){
    int c;
    for(int i=0;i<tam;i++){
        c = vtipo[i];
        printf("\nProduto %d: %s - Código: %d - Categoria: %s\n\tPreço: R$ %.2f\n\tEstoque: %d unidades disponíveis\n\n", i+1, v1[i], vCodProd[i], v2[c], preco[i], vEstoque[i]);
    }
}

void exibeCarrinho(int tam, int ind, int nome[], int vCodProd[], char vNomeProd[][40], int qtdd[], float valor[]){
    int w;
    for(int i=0;i<=ind;i++){
        w = busca(vCodProd, tam, nome[i]);
        printf("\nItem %d: %s - %d - R$ %.2f", i+1, vNomeProd[w], qtdd[i], valor[i]);
    }
}

void exibeCompra(char n[], int tam, char vNomeProd[][40], int vCodProd[], int vEstoque[], int vTipoProd[], char vNomeTipo[][20], float vPreco[]){
    int cod, ctg, confirma1, confirma2, qtd = 0;
    float valorTotal = 0;
    int nome[1000];
    int qtdd[1000];
    float valor[1000];
    printf("\n\nDigite o código do produto, %s: ", n);
    scanf("%4d", &cod);
    int ind = 0;
    while(cod!=0){
    cod = busca(vCodProd, tam, cod);
    confirma1 = 0;
    if(cod==-1){
        printf("\nProduto não encontrado.");
    } else {
        if(vEstoque[cod]==0){
            printf("\nSem unidades disponíveis para venda.");
        } else {
            ctg = vTipoProd[cod];
            printf("\nProduto: %s | Categoria: %s", vNomeProd[cod], vNomeTipo[ctg]);
            printf("\nValor: R$ %.2f\n", vPreco[cod]);
            printf("Digite a quantidade: ");
            scanf("%d", &qtd);
            if(qtd>0){
            while(qtd>vEstoque[cod]){
                printf("\nQuantidade maior do que o estoque.");
                printf("\nDigite uma quantidade menor: ");
                scanf("%d", &qtd);
            }
            printf("Valor total: R$ %.2f", vPreco[cod]*qtd);
            while(confirma1!=1 && confirma1!=2){
                printf("\nDeseja adicionar o produto no carrinho?\nDigite 1 (Sim) ou 2 (Não): ");
                scanf("%1d", &confirma1);
                if(confirma1==1){
                    vEstoque[cod] -= qtd;
                    printf("\n++Adicionado ao carrinho.");
                    valorTotal += vPreco[cod]*qtd;
                    nome[ind] = vCodProd[cod];
                    qtdd[ind] = qtd;
                    valor[ind] = vPreco[cod]*qtd;
                    printf("\nTotal da compra: R$ %.2f", valorTotal);
                    ind++;
                } else {
                    printf("\nProduto descartado.");
                }
            } 
        } else {
                printf("\nDigite uma quantidade maior que 0.");
            }
        }
    }
    printf("\n%s, digite o código de um novo produto ou 0 para finalizar: ", n);
    scanf("%4d", &cod);
    }
    
    printf("\nItens no carrinho:");
    if(ind!=0){
    exibeCarrinho(tam, ind-1, nome, vCodProd, vNomeProd, qtdd, valor);
    printf("\nValor total da compra: R$ %.2f", valorTotal);
    confirma2 = 0;
    while(confirma2!=1 && confirma2!=2){
    printf("\n\nDeseja confirmar a compra dos produtos?\n Digte 1 (Sim) ou 2 (Não): ");
    scanf("%1d", &confirma2);
    }
    if(confirma2==2){
        printf("\nSua compra foi cancelada.");
    } else {
        printf("\nSua compra foi finalizada!");
    }} else {
        printf("\nVocê não realizou compras");
    }
    
}

void exibeVenda(int tam, char vNomeProd[][40], int vCodProd[], int vEstoque[], int vTipoProd[], char vNomeTipo[][20], float vPreco[]){
    char vNome[20];
    printf("\nDigite o seu primeiro nome: ");
    scanf(" %s", vNome);
    while(1){
        exibeCompra(vNome, tam, vNomeProd, vCodProd, vEstoque, vTipoProd, vNomeTipo, vPreco);
        printf("\nDigite o seu primeiro nome: ");
        scanf(" %s", vNome);
    }
}

